generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum CameraStatus {
  ONLINE
  OFFLINE
  DEGRADED
  DISABLED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
}

enum WatchlistPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WatchlistStatus {
  ACTIVE
  INACTIVE
  REVIEW
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  passwordHash  String
  role          UserRole    @default(OPERATOR)
  department    String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Camera {
  id              String       @id @default(cuid())
  cameraCode      String       @unique
  name            String
  department      String
  zone            String
  latitude        Float
  longitude       Float
  cameraType      String
  sourceProtocol  String
  streamReference String
  status          CameraStatus @default(ONLINE)
  lastHeartbeat   DateTime?
  storageReference String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  detections      Detection[]
  alerts          Alert[]
}

model Detection {
  id            String   @id @default(cuid())
  cameraId      String
  timestamp     DateTime
  eventType     String
  vehicleNumber String?
  vehicleType   String?
  confidence    Float?
  boundingBox   Json?
  rawPayload    Json?
  createdAt     DateTime @default(now())

  camera        Camera   @relation(fields: [cameraId], references: [id])
  alert         Alert?
}

model WatchlistEntry {
  id          String            @id @default(cuid())
  entityType  String
  identifier  String            @unique
  name        String
  description String?
  priority    WatchlistPriority @default(MEDIUM)
  status      WatchlistStatus   @default(ACTIVE)
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  alerts      Alert[]
}

model Alert {
  id              String       @id @default(cuid())
  detectionId     String       @unique
  watchlistId     String?
  cameraId        String
  severity        AlertSeverity @default(HIGH)
  status          AlertStatus   @default(NEW)
  timestamp       DateTime      @default(now())
  location       String?
  confidence      Float?
  matchedEntity   String?
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  resolvedBy      String?
  resolvedAt      DateTime?

  detection       Detection     @relation(fields: [detectionId], references: [id])
  watchlist       WatchlistEntry? @relation(fields: [watchlistId], references: [id])
  camera          Camera        @relation(fields: [cameraId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  actor       String?
  action      String
  entityType  String
  entityId    String
  details     Json?
  createdAt   DateTime @default(now())
}
